# TIMEORA Backend Environment Configuration
# Copy this file to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development

# Database - Choose ONE:
# Option A: Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/timeora_watches
# Option B: MongoDB Atlas (preferred for production)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xjmpjgh.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=your_strong_random_secret_here_min_32_chars
JWT_EXPIRE=30d

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Admin Credentials (set in DB, not here)
# ADMIN_EMAIL=admin@timeora.com
# ADMIN_PASSWORD=your_secure_admin_password
# ADMIN_LOGIN_ID=timeoraa
# For initial admin account setup only; enter this in server/.env, run `npm run setup:admin`, then remove the password variable.
# ADMIN_INITIAL_PASSWORD=use-a-new-unique-password

# Razorpay Payment (India)
# Get keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP) - for verification, reset, order emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=timeora@concierge.com

# Tax/GST (decimal, e.g. 0.18 = 18%)
TAX_RATE=0.18

# Shipping
FREE_SHIPPING_THRESHOLD=5000
SHIPPING_STANDARD=200
SHIPPING_EXPRESS=500

# Inventory
LOW_STOCK_THRESHOLD=5

# Upload (bytes)
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm

# TIMEORA AI Voice Support (optional; calls stay disabled until configured)
# OpenAI server-side API key. Never put this in client/.env or a VITE_ variable.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime

# Twilio Voice. Create an API key, a Voice application, and configure its Voice URL.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_APP_SID=
# Set to the exact public HTTPS base URL, without a trailing slash.
TWILIO_PUBLIC_BASE_URL=https://your-domain.example
# Public WSS media-stream server. Persistent Node hosting is recommended for call duration; Vercel WebSockets are Beta on Fluid Compute and limited by Function duration.
VOICE_STREAM_BASE_URL=wss://your-persistent-node-host.example
# Incoming phone calls remain unavailable unless this exact TIMEORA support number is provisioned with Twilio inbound voice.
TWILIO_PHONE_NUMBER=+918469965711
# Twilio IncomingPhoneNumber resource SID (PN...). Backend verifies its voice capability and exact webhook URL before reporting phone AI as configured.
TWILIO_PHONE_NUMBER_SID=

# Twilio Voice application Voice URL: https://your-domain.example/api/voice/twiml (POST)
# Twilio status callback URL: https://your-domain.example/api/voice/status (POST)
# Configure these separately for the Voice application and inbound number in Twilio Console.
